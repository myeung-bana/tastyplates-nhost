# Optional Hasura CLI config — only if CI/scripts call `hasura` directly.
# Normal Nhost deploy uses nhost/nhost.toml and does NOT require this file.
#
# Copy to config.yaml at repo root and set secrets via environment:
#   cp config.yaml.example config.yaml
#   hasura metadata apply --admin-secret "$HASURA_GRAPHQL_ADMIN_SECRET"
#
version: 3
endpoint: https://<subdomain>.hasura.<region>.nhost.run
metadata_directory: nhost/metadata
migrations_directory: nhost/migrations
