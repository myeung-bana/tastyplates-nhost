# Local-only copy to `.secrets` at this repo root (never commit `.secrets`).
# Nhost CLI maps these Dashboard source names onto runtime vars (see documentation/correction.md Fix 9).
#
HASURA_GRAPHQL_ADMIN_SECRET='your-local-hasura-admin-secret'
HASURA_GRAPHQL_JWT_SECRET='your-local-jwt-secret-string'
GRAFANA_ADMIN_PASSWORD='your-local-grafana-password'

# Google OAuth (Nhost Auth — mobile/web sign-in). Use the same Web application client as tastyplates-v2-1.
# Google Console redirect URI: https://ygmkmxorcapgpimwerpc.auth.ap-southeast-1.nhost.run/v1/signin/provider/google/callback
GOOGLE_CLIENT_ID='your-google-oauth-client-id.apps.googleusercontent.com'
GOOGLE_CLIENT_SECRET='your-google-oauth-client-secret'

# Mailgun SMTP (Nhost Auth transactional email — verification, password reset)
MAILGUN_SMTP_PASSWORD='your-mailgun-smtp-password'

# Media upload — Nhost Storage (tasty-bucket must exist with public download for display URLs)
MEDIA_STORAGE_BUCKET='tasty-bucket'

# Google Places — server-side photo fetch when creating restaurants from Place Details
GOOGLE_MAPS_API_KEY='your-google-maps-api-key-with-places-enabled'

# Optional: path to local tastyplates-admin-mcp package for MCP settings "Local dev" config
# MCP_LOCAL_PACKAGE_PATH='/absolute/path/to/tastyplates-admin-mcp'

# Optional: auth.users UUID for catalog uploaded_by when admin/migrate-media migrates restaurant images
# MEDIA_MIGRATION_ACTOR_ID='00000000-0000-0000-0000-000000000000'

# Apify external data scrape (see documentation/migrations/add_restaurant_external_data.md)
APIFY_TOKEN='your-apify-api-token'
APIFY_GOOGLE_ACTOR_ID='compass/crawler-google-places'
APIFY_WEBHOOK_SECRET='generate-a-random-secret-for-webhook-auth'
